# Copy this file to ~/.opencodex/endpoints.env on a target device, replace
# every placeholder locally, and keep the resulting file private (chmod 600).
# Never commit the filled-in copy.

export OPENAI_CODEX_BASE_URL="<YOUR_OPENAI_CODEX_BASE_URL>"
export KIMI_CODE_BASE_URL="<YOUR_KIMI_CODE_BASE_URL>"
export CLAUDE_FABLE_BASE_URL="<YOUR_CLAUDE_FABLE_BASE_URL>"

# Optional. If the target device does not need an upstream proxy, remove the
# `proxy` line from config.json instead of leaving this placeholder active.
export UPSTREAM_PROXY_URL="<YOUR_UPSTREAM_PROXY_URL>"
